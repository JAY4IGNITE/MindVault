PORT=3000
NODE_ENV=development
GOOGLE_CLOUD_PROJECT_ID=mindvault-local
GEMINI_SECRET_NAME=projects/mindvault-local/secrets/gemini-api-key/versions/latest
# Optional local API key fallback if GCP Secret Manager is not configured
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
