{
  "name": "mindvault-backend",
  "version": "1.0.0",
  "description": "MindVault AI Secure Fastify API with Firebase Admin & Gemini",
  "main": "dist/index.js",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first ts-node src/index.ts",
